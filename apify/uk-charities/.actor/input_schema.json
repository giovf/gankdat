{
  "title": "UK Charities Register (Charity Commission) — leads & due diligence — filters",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "Current records (default), or only the records added, removed or changed since a date — schedule a daily run in changes mode to monitor the register and pay only for what changed.",
      "editor": "select",
      "enum": ["data", "changes"],
      "enumTitles": ["Current records", "Changes since a date (monitor)"],
      "default": "data"
    },
    "since": {
      "title": "Changes since",
      "type": "string",
      "description": "Changes mode only: YYYY-MM-DD. Default: the last 7 days. The feed keeps 90 days.",
      "editor": "textfield",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "change": {
      "title": "Change type",
      "type": "string",
      "description": "Changes mode only: one kind of change. Default: all three.",
      "editor": "select",
      "enum": ["added", "removed", "changed"],
      "enumTitles": ["Added to the register", "Removed from the register", "Changed"]
    },
    "name": {
      "title": "Name contains",
      "type": "string",
      "editor": "textfield",
      "description": "Filter: Name contains (case-insensitive substring match)."
    },
    "charity_type": {
      "title": "Charity type contains",
      "type": "string",
      "description": "CIO, Charitable company, Trust, Previously excepted, Other",
      "editor": "textfield"
    },
    "reporting_status": {
      "title": "Reporting status contains",
      "type": "string",
      "description": "e.g. Submission Received, Submission Received Late, Submission Double Default, New",
      "editor": "textfield"
    },
    "outward_code": {
      "title": "Postcode area (outward code)",
      "type": "string",
      "description": "e.g. LS1, SW1A",
      "editor": "textfield"
    },
    "latest_income_min": {
      "title": "Minimum latest income (£)",
      "type": "integer",
      "minimum": 0,
      "description": "Filter: Minimum latest income (£)."
    },
    "latest_income_max": {
      "title": "Maximum latest income (£)",
      "type": "integer",
      "minimum": 0,
      "description": "Filter: Maximum latest income (£)."
    },
    "date_of_registration_after": {
      "title": "Registered on or after",
      "type": "string",
      "description": "YYYY-MM-DD",
      "editor": "textfield",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "in_administration": {
      "title": "Only charities in administration",
      "type": "boolean",
      "default": false,
      "description": "Filter: Only charities in administration."
    },
    "q": {
      "title": "Free-text search",
      "type": "string",
      "editor": "textfield",
      "description": "Filter: Free-text search (case-insensitive substring match)."
    },
    "max_results": {
      "title": "Maximum results",
      "type": "integer",
      "description": "Stop after this many records (you are charged per result).",
      "default": 1000,
      "minimum": 1,
      "maximum": 100000
    }
  },
  "required": []
}
