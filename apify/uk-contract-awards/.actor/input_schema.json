{
  "title": "UK Contract Awards \u2014 filters",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "supplier": {
      "title": "Supplier contains",
      "type": "string",
      "description": "Filter: Supplier contains (case-insensitive substring match).",
      "editor": "textfield"
    },
    "buyer": {
      "title": "Buyer contains",
      "type": "string",
      "description": "Filter: Buyer contains (case-insensitive substring match).",
      "editor": "textfield"
    },
    "supplier_company_number": {
      "title": "Supplier company number",
      "type": "string",
      "description": "Companies House number, e.g. 10135058",
      "editor": "textfield"
    },
    "cpv_codes": {
      "title": "CPV code",
      "type": "string",
      "description": "e.g. 45000000 (construction), 72000000 (IT)",
      "editor": "textfield"
    },
    "category": {
      "title": "Category",
      "type": "string",
      "description": "works, services, goods",
      "editor": "textfield"
    },
    "award_value_amount_min": {
      "title": "Minimum award value",
      "type": "integer",
      "description": "Filter: minimum award value.",
      "minimum": 0
