{
  "title": "UK Sanctions List (FCDO) \u2014 designations \u2014 filters",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "name": {
      "title": "Name contains",
      "type": "string",
      "description": "Filter: Name contains (case-insensitive substring match).",
      "editor": "textfield"
    },
    "regime": {
      "title": "Regime contains",
      "type": "string",
      "description": "e.g. Russia, Global Human Rights, Libya",
      "editor": "textfield"
    },
    "designation_type": {
      "title": "Designation type contains",
      "type": "string",
      "description": "Individual, Entity, Ship",
      "editor": "textfield"
    },
    "countries": {
      "title": "Country contains",
      "type": "string",
      "description": "Filter: Country contains (case-insensitive substring match).",
      "editor": "textfield"
    },
    "date_designated_after": {
      "title": "Designated on or after",
      "type": "string",
      "description": "YYYY-MM-DD",
      "editor": "textfield",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_updated_after": {
      "title": "Updated on or after",
      "type": "string",
      "description": "YYYY-MM-DD",
      "editor": "textfield",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "q": {
      "title": "Free-text search",
      "type": "string",
      "description": "Matches names, aliases, regime.",
      "editor": "textfield"
    },
    "max_results": {
      "title": "Maximum results",
      "type": "integer",
      "description": "Stop after this many records (you are charged per result).",
      "default": 1000,
      "minimum": 1,
      "maximum": 100000
    }
  },
  "required": []
}
