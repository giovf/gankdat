# /account may load the Cloudflare Turnstile widget (dark until a site key is
# set in /js/account.js) — allow its script, XHR, and iframe.
/account
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

/account.html
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

# /docs renders the Scalar API reference (vendored from jsdelivr) — a
# third-party SPA that injects styles and may eval. Scoped-loose here; the
# rest of the site stays strict.
/docs
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; connect-src 'self' https://cdn.jsdelivr.net; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

/docs.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; connect-src 'self' https://cdn.jsdelivr.net; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

# /addin/* — the Excel add-in's pages load Office.js from Microsoft's CDN and run inside
# Office's webview (an iframe on Excel for the web), so these pages alone allow Microsoft's
# frames and script host; X-Frame-Options DENY from /* would break the pane, so it is overridden.
/addin
  ! X-Frame-Options
  Content-Security-Policy: default-src 'self'; script-src 'self' https://appsforoffice.microsoft.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://appsforoffice.microsoft.com; form-action 'self'; frame-ancestors https://*.officeapps.live.com https://*.office.com https://*.microsoft.com https://*.sharepoint.com https://*.officeapps.live.com https://*.cloud.microsoft; base-uri 'none'; object-src 'none'

/addin.html
