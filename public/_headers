# Security headers for static assets (served by the Workers Assets pipeline
# through env.ASSETS in src/middleware/canonical.ts, before Hono's
# secureHeaders() runs — so these are set here, mirroring the secureHeaders()
# config in src/index.ts for dynamic responses).
#
# CSP is per-page rather than one /* rule: multiple matching CSP headers are
# enforced as their INTERSECTION, so a global strict script-src would also
# clamp /docs (Scalar) and /account (Turnstile). The non-CSP headers below are
# safe universally; each HTML page declares its own CSP. Pages with no inline
# scripts run under strict script-src 'self' (all page JS is in /js/*.js);
# style-src keeps 'unsafe-inline' (inline <style>/attrs are low-risk and
# pervasive). Both pretty and .html paths are listed.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains

/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

